# Copy to .env and fill in. Never commit .env.

# Long random string used to sign admin logins (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PAYLOAD_SECRET=

# Database. Leave empty for local development (uses a SQLite file, parqon.db).
# Production: a Postgres connection string, e.g. from Neon (Vercel Marketplace).
DATABASE_URL=

# Uploads (images, brochure PDFs, certificate logos). Leave empty to store uploads on disk in development.
# Production: an S3 bucket (can sit behind the existing CloudFront distribution).
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public URL for uploaded files, e.g. https://dueyys3d8qg20.cloudfront.net/cms
S3_PUBLIC_URL=

# Where quote / sample / enquiry leads are e-mailed (the existing AWS Lambda endpoint)
LEAD_ENDPOINT=https://vgiwdmx3zpohc62m5gqsnnj3ee0owsue.lambda-url.ap-south-1.on.aws/

# Public site URL (used in lead e-mails and metadata)
NEXT_PUBLIC_SITE_URL=https://parqon.co.in
